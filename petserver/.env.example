# ====================== 服务器配置 ======================
# 服务端口（默认 8080，可修改避免端口冲突）
SERVER_PORT=8080

# ====================== 数据库配置（MySQL） ======================
# 数据库连接地址（本地 MySQL 默认为 localhost:3306，数据库名为 petshop）
DB_URL=jdbc:mysql://localhost:3306/petshop?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# 数据库用户名（本地默认 root）
DB_USERNAME=root
# 数据库密码（替换为你的 MySQL 密码）
DB_PASSWORD=root

# ====================== MyBatis-Plus 配置 ======================

JWT_SECRET=xx

DEEPSEEK_API_KEY=sk-xxx